{
  "manifest_version": "0.4",
  "name": "kleinanzeigen-mcp",
  "display_name": "Kleinanzeigen",
  "version": "1.0.0",
  "description": "Search Kleinanzeigen.de classifieds: listings, full ad details, photos and seller trust signals.",
  "long_description": "Searches Kleinanzeigen.de with categories, category filters, location and radius, filters out accessories and wrong variants server-side, and reads full ads, their photos and the seller's reputation. Unofficial; uses the Kleinanzeigen app API.",
  "author": {
    "name": "Samxel",
    "url": "https://github.com/Samxel"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Samxel/kleinanzeigen-mcp"
  },
  "homepage": "https://github.com/Samxel/kleinanzeigen-mcp",
  "support": "https://github.com/Samxel/kleinanzeigen-mcp/issues",
  "server": {
    "type": "uv",
    "entry_point": "main.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${__dirname}",
        "main.py",
        "--stdio"
      ]
    }
  },
  "tools": [
    {
      "name": "search_kleinanzeigen",
      "description": "Search listings, with filters run server-side"
    },
    {
      "name": "get_ad_detail",
      "description": "One ad or several in full"
    },
    {
      "name": "get_ad_images",
      "description": "An ad's photos"
    },
    {
      "name": "get_seller_info",
      "description": "Who sells an ad"
    },
    {
      "name": "search_locations",
      "description": "Location ids by name"
    },
    {
      "name": "get_category_filters",
      "description": "A category's attribute filters"
    },
    {
      "name": "list_categories",
      "description": "Category ids by name"
    }
  ],
  "keywords": [
    "kleinanzeigen",
    "classifieds",
    "kleinanzeigen.de",
    "second-hand"
  ],
  "license": "MIT",
  "privacy_policies": [
    "https://themen.kleinanzeigen.de/datenschutzerklaerung/"
  ],
  "compatibility": {
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ],
    "runtimes": {
      "python": ">=3.10"
    }
  }
}
